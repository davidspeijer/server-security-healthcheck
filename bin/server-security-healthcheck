#!/usr/bin/env bash
set -u
set -o pipefail

APP_NAME="server-security-healthcheck"
APP_VERSION="0.5.3"
if [ "${1:-}" = --version ]; then
    printf '%s v%s\n' "$APP_NAME" "$APP_VERSION"
    exit 0
fi
if [ "${BASH_VERSINFO[0]}" -lt 4 ]; then
    echo 'ERROR Bash 4 or newer is required' >&2
    exit 2
fi
CONFIG_DIR="${SSHC_CONFIG_DIR:-/etc/server-security-healthcheck}"
LIB_DIR="${SSHC_LIB_DIR:-/usr/local/lib/server-security-healthcheck}"
MAIN_CONFIG="${CONFIG_DIR}/healthcheck.conf"
TELEGRAM_CONFIG="${CONFIG_DIR}/telegram.conf"
LIB_DIR="$(cd -P -- "$LIB_DIR" 2>/dev/null && pwd)" || { echo 'ERROR runtime directory unavailable' >&2; exit 2; }
CHECK_DIR="${LIB_DIR}/checks"
NOTIFY_DIR="${LIB_DIR}/notify"

[ -f "${LIB_DIR}/common.sh" ] && [ -r "${LIB_DIR}/common.sh" ] || {
    echo "ERROR missing ${LIB_DIR}/common.sh" >&2
    exit 2
}

# shellcheck source=/dev/null
if ! bash -n "${LIB_DIR}/common.sh" || ! source "${LIB_DIR}/common.sh"; then
    echo "ERROR common module could not be loaded: ${LIB_DIR}/common.sh" >&2
    exit 2
fi

[ -r "$MAIN_CONFIG" ] || {
    hc_log "ERROR missing config: $MAIN_CONFIG"
    exit 2
}
hc_require_dependencies || exit 2
hc_load_config "$MAIN_CONFIG" || exit 2

if ! telegram_config_state="$(hc_data_parse file-state "$TELEGRAM_CONFIG" 2>/dev/null)" ||
   [[ "$telegram_config_state" != ABSENT && "$telegram_config_state" != PRESENT ]]; then
    hc_status ERROR "Telegram configuration source UNKNOWN: $TELEGRAM_CONFIG"
    exit 2
fi
if [ "$telegram_config_state" = PRESENT ]; then
    hc_load_config "$TELEGRAM_CONFIG" || exit 2
fi

HC_REGISTERED_CHECKS=()
HC_DISABLED=0

# A selected backend is a required runtime dependency, even on healthy runs.
HC_NOTIFY_READY=0
if hc_enabled "${NOTIFY_TELEGRAM:-0}" || [ "${1:-}" = --test-notification ]; then
    module="${NOTIFY_DIR}/telegram.sh"
    unset -f notify_telegram notify_test
    if [ ! -f "$module" ] || [ ! -r "$module" ]; then
        hc_status ERROR "Required notification backend missing or unreadable: $module"
    elif ! bash -n "$module" 2>/dev/null; then
        hc_status ERROR "Notification backend syntax error: $module"
    elif ! source "$module"; then
        hc_status ERROR "Notification backend source failed: $module"
        unset -f notify_telegram notify_test
    elif ! hc_function_from notify_telegram "$module" || ! hc_function_from notify_test "$module"; then
        hc_status ERROR 'Notification backend function missing or from unexpected module'
        unset -f notify_telegram notify_test
    else
        HC_NOTIFY_READY=1
    fi
fi

# Only registry entries are executable checks; unrelated files are never sourced.
declare -A HC_REQUIRED HC_LOADED HC_EXECUTED
for check_name in "${HC_REG_NAMES[@]}"; do
    [ "${HC_REG_KIND[$check_name]}" != helper ] || continue
    config_key="${HC_REG_CONFIG[$check_name]}"
    value="${!config_key:-${HC_REG_DEFAULT[$check_name]}}"
    [ "$check_name" != lmd ] || value="${LMD_ENABLED:-$value}"
    if [ "$(hc_mode "$value")" = off ]; then
        HC_DISABLED=$((HC_DISABLED + 1))
        [ "${1:-}" = --list-checks ] || continue
    fi
    HC_REQUIRED[$check_name]=1
    dependency="${HC_REG_DEP[$check_name]}"
    [ "$dependency" = - ] || HC_REQUIRED[$dependency]=1
done
if [ -e "$LIB_DIR/.runtime.manifest" ] || [ -L "$LIB_DIR/.runtime.manifest" ]; then
    expected_manifest="$(hc_runtime_manifest "$LIB_DIR")"
    manifest_status=$?
    installed_manifest="$(hc_data_parse bounded "$LIB_DIR/.runtime.manifest")"
    read_status=$?
    if [ "$manifest_status" != 0 ] || [ "$read_status" != 0 ] || [ "$expected_manifest" != "$installed_manifest" ]; then
        hc_status ERROR 'Registry/runtime manifest mismatch'
        exit 2
    fi
elif [ -e "$LIB_DIR/bin/server-security-healthcheck" ]; then
    hc_status ERROR 'Installed runtime ownership manifest missing'
    exit 2
fi
for check_name in "${HC_REG_NAMES[@]}"; do
    [ "${HC_REQUIRED[$check_name]:-0}" = 1 ] || continue
    module="${LIB_DIR}/${HC_REG_MODULE[$check_name]}"
    hc_registry_module_load "$check_name" "$LIB_DIR"
    module_status=$?
    [ "$module_status" != 0 ] || HC_LOADED[$check_name]=1
done

if [ "$HC_NOTIFY_READY" = 1 ] &&
   { ! hc_function_from notify_telegram "${NOTIFY_DIR}/telegram.sh" || ! hc_function_from notify_test "${NOTIFY_DIR}/telegram.sh"; }; then
    hc_status ERROR 'Notification backend function missing or from unexpected module'
    HC_NOTIFY_READY=0
fi

case "${1:-}" in
    --test-notification)
        if [ "$HC_NOTIFY_READY" = 1 ] && hc_function_from notify_test "${NOTIFY_DIR}/telegram.sh"; then
            notify_test
            exit $?
        fi
        hc_log "ERROR no notification backend with notify_test found"
        exit 2
        ;;
    --list-checks)
        printf '%s\n' "${HC_REGISTERED_CHECKS[@]}"
        [ "$HC_ERRORS" -eq 0 ] || exit 2
        exit 0
        ;;
    --help|-h)
        cat <<'EOF'
Usage:
  server-security-healthcheck
  server-security-healthcheck --test-notification
  server-security-healthcheck --list-checks
  server-security-healthcheck --help
  server-security-healthcheck --version
EOF
        exit 0
        ;;
    '') ;;
    *) hc_status ERROR "Unknown argument: $1"; exit 2 ;;
esac

for check_name in "${HC_REG_NAMES[@]}"; do
    [ "${HC_REG_KIND[$check_name]}" != helper ] || continue
    [ "${HC_REQUIRED[$check_name]:-0}" = 1 ] || continue
    [ "${HC_LOADED[$check_name]:-0}" = 1 ] || continue
    dependency="${HC_REG_DEP[$check_name]}"
    if [ "$dependency" != - ] && [ "${HC_LOADED[$dependency]:-0}" != 1 ]; then
        hc_status ERROR "Required check dependency unavailable: $check_name/$dependency"
        continue
    fi
    function_name="${HC_REG_FUNCTION[$check_name]}"
    registered=0
    for registered_name in "${HC_REGISTERED_CHECKS[@]}"; do
        [ "$registered_name" != "$check_name" ] || registered=$((registered + 1))
    done
    if [ "$registered" != 1 ] || ! hc_function_from "$function_name" "$LIB_DIR/${HC_REG_MODULE[$check_name]}"; then
        hc_status ERROR "Required check not registered or function from unexpected module: $check_name"
        continue
    fi
    HC_EXECUTED[$check_name]=1
    execution_failed=0
    set -E
    trap 'execution_failed=1' ERR
    "$function_name"
    execution_status=$?
    trap - ERR
    set +E
    if [ "$execution_status" != 0 ] || [ "$execution_failed" != 0 ]; then
        hc_status ERROR "Check execution failed: $check_name"
    fi
done
for check_name in "${!HC_REQUIRED[@]}"; do
    [ "${HC_REG_KIND[$check_name]}" != helper ] || continue
    [ "${HC_EXECUTED[$check_name]:-0}" = 1 ] || hc_status ERROR "Required check not executed: $check_name"
done

# Checks may load extension code; recheck provenance before using the backend.
if [ "$HC_NOTIFY_READY" = 1 ] &&
   { ! hc_function_from notify_telegram "${NOTIFY_DIR}/telegram.sh" || ! hc_function_from notify_test "${NOTIFY_DIR}/telegram.sh"; }; then
    hc_status ERROR 'Notification backend function missing or from unexpected module'
    HC_NOTIFY_READY=0
fi

executed_count=0
for check_name in "${!HC_EXECUTED[@]}"; do executed_count=$((executed_count + 1)); done
hc_log "Checks: executed=$executed_count disabled=$HC_DISABLED not_applicable=$HC_NOT_APPLICABLE discovery_failed=$HC_DISCOVERY_FAILED"

if [ "${#HC_WARNINGS[@]}" -eq 0 ] && [ "$HC_ERRORS" -eq 0 ]; then
    hc_log "OK all enabled checks passed"
    exit 0
fi

host="$(hc_present "$(hostname -f 2>/dev/null || hostname)")"
message="⚠️ Security healthcheck — ${host}
$(date '+%Y-%m-%d %H:%M:%S %Z')

Problems found: ${#HC_WARNINGS[@]}
Execution errors: ${HC_ERRORS}

"

i=1
# Prioritize critical findings, then execution errors, then policy warnings so
# warning bursts cannot hide errors. CLI output remains in check execution order.
for severity in CRITICAL ERROR WARNING; do
    for item in "${HC_WARNINGS[@]}" "${HC_ERROR_MESSAGES[@]}"; do
        [[ "$item" = "$severity "* ]] || continue
        message+="${i}. ${item}"$'\n'
        i=$((i + 1))
    done
done

if [ "${#HC_DETAILS[@]}" -gt 0 ]; then
    message+=$'\n'"Context:"$'\n'
    for item in "${HC_DETAILS[@]}"; do
        message+="• ${item}"$'\n'
    done
fi

if [ "$HC_NOTIFY_READY" = 1 ] && hc_function_from notify_telegram "${NOTIFY_DIR}/telegram.sh"; then
    notify_telegram "$message" || {
        printf '%s\n' "$message" >&2
        exit 2
    }
else
    printf '%s\n' "$message" >&2
fi

# Preserve findings notifications even if another check could not execute.
# The execution error still takes precedence in the final exit status.
[ "$HC_ERRORS" -eq 0 ] || exit 2
exit 1
