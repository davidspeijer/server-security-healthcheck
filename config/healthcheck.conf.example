# Server Security Healthcheck

LOOKBACK_HOURS=24

# Notifications
NOTIFY_TELEGRAM=0

# Configuration is literal KEY=value data; no shell expansion or commands.
# Service integrations support 1, 0 or auto unless otherwise noted.

# Apache
CHECK_APACHE=auto
APACHE_SERVICE=httpd

# Rspamd
CHECK_RSPAMD=auto
RSPAMD_SERVICE=rspamd

# PureFTP upload scanner
CHECK_PUREFTP=auto
PUREFTP_UPLOADSCAN_SERVICE=pure-uploadscript

# Exim
CHECK_EXIM=0
EXIM_SERVICE=exim
MAILQUEUE_WARN=25

# Disk
CHECK_DISK=1
DISK_WARN_PERCENT=80
DISK_PATHS="/ /home /var /tmp"

# ClamAV
CHECK_CLAMAV=auto
CLAMAV_SERVICE=clamd@scan
CLAM_SIG_MAX_AGE_HOURS=48
FRESHCLAM_MAX_AGE_HOURS=36
FRESHCLAM_SERVICE=clamav-freshclam.service
FRESHCLAM_TIMER=clamav-freshclam-once.timer
FRESHCLAM_ONESHOT_SERVICE=clamav-freshclam-once.service

# -------------------------------------------------------------------
# Linux Malware Detect (LMD)
# -------------------------------------------------------------------
# 1 = required, 0 = disabled, auto = only when LMD_DIR exists.
# Legacy CHECK_LMD is used if LMD_ENABLED is absent.
LMD_ENABLED=auto
LMD_DIR=/usr/local/maldetect
LMD_SERVICE=maldet.service
LMD_AUDIT=/var/log/maldet/audit.log
# Optional path overrides (defaults derive from LMD_DIR).
# LMD_EVENT_LOG=/usr/local/maldetect/logs/event_log
# LMD_SESSION_DIR=/usr/local/maldetect/sess

LMD_MONITOR_REQUIRED=1
LMD_MONITOR_MAX_IDLE_MINUTES=90
# Match inotifywait's list-driven monitor. This is a regex, never a command.
LMD_MONITOR_PROCESS_PATTERN="inotifywait.*(--fromfile|--from-file)"

# Signature checks every 6 hours, with 2 hours margin.
LMD_SIGUP_MAX_AGE_HOURS=8
# Recent explicit failures; applies to signature and enabled program updater.
LMD_UPDATE_FAILURE_LOOKBACK_HOURS=48
# LMD_SIG_MAX_AGE_HOURS is deprecated and ignored: unchanged signatures
# can be healthy after a successful 'already installed' update check.

# Weekly full scan: 8 days allows one day's margin.
LMD_FULLSCAN_MAX_AGE_HOURS=192
LMD_FULLSCAN_MAX_RUNTIME_HOURS=12
LMD_EXPECTED_FULLSCAN_PATH="/home/?/domains/?/public_html/"
# Legacy FULLSCAN_MAX_AGE_DAYS is used if the new hours setting is absent.

# enabled | disabled | ignore. This declares policy, it does not change LMD.
LMD_PROGRAM_UPDATE_EXPECTED=disabled
# 0 | 1 | ignore. This example expects LMD to quarantine malware hits.
# Intended LMD policy (configure separately in LMD, not in this file):
# quarantine_hits=1, quarantine_clean=0, quarantine_suspend_user=0,
# quarantine_on_error=0: scanner errors alone should not trigger quarantine.
# The policy check also compares the live configuration; scan metadata remains
# a separate view of the policy used by that particular scan.
# If this key is absent, the legacy default remains 0 for compatibility.
LMD_EXPECT_QUARANTINE_ENABLED=1

# Optional DirectAdmin layout comparison; enable explicitly on those servers.
CHECK_DIRECTADMIN_WEBROOTS=0
DIRECTADMIN_HOME=/home
# Legacy LMD_MONITOR_LIST is used when LMD_WEBROOT_LIST is absent.
LMD_WEBROOT_LIST=/usr/local/maldetect/directadmin-webroots

# -------------------------------------------------------------------
# LMD - Expected configuration and scheduling
# -------------------------------------------------------------------
# Read-only, enabled by default when the LMD integration runs.
# 0 skips configuration/cron validation; operational checks still run.
LMD_CONFIG_CHECK_ENABLED=1

# Location overrides; omitted paths derive from LMD_DIR or use the paths below.
# LMD_CONFIG_FILE=/usr/local/maldetect/conf.maldet
# LMD_CRON_CONFIG_FILE=/usr/local/maldetect/cron/conf.maldet.cron
# LMD_COMPAT_CONFIG_FILE=/usr/local/maldetect/internals/compat.conf
# LMD_SYSCONFIG_FILE=/etc/sysconfig/maldet
# LMD_DEFAULT_FILE=/etc/default/maldet
# LMD_DAILY_CRON_FILE=/etc/cron.daily/maldet
# LMD_SIGUP_CRON_FILE=/etc/cron.d/maldet-sigup
# LMD_FULLSCAN_CRON_FILE=/etc/cron.d/maldet-fullscan

# Policy mismatches are WARNING. Most expectations also accept "ignore".
LMD_EXPECT_EMAIL_ALERT=1
LMD_EXPECT_AUTOUPDATE_SIGNATURES=1
LMD_EXPECT_SIGUP_INTERVAL=6
# Base permits updates; the daily context intentionally overrides both to 0.
LMD_EXPECT_AUTOUPDATE_VERSION=1
LMD_EXPECT_CRON_AUTOUPDATE_VERSION=0
LMD_EXPECT_CRON_AUTOUPDATE_SIGNATURES=0
LMD_EXPECT_SCAN_CLAMSCAN=auto
# LMD_EXPECT_QUARANTINE_ENABLED is defined in the LMD section above.
LMD_EXPECT_QUARANTINE_CLEAN=0
LMD_EXPECT_QUARANTINE_SUSPEND_USER=0
LMD_EXPECT_QUARANTINE_ON_ERROR=0
LMD_EXPECT_MONITOR_MODE=/usr/local/maldetect/directadmin-webroots
LMD_EXPECT_INOTIFY_SLEEP=15
LMD_EXPECT_INOTIFY_RELOADTIME=3600
# Empty means MUST be empty; missing or dynamic values are not assumed empty.
LMD_EXPECT_IMPORT_CONFIG_URL=""
LMD_EXPECT_POST_SCAN_HOOK=""

# Preferences only: differences in tuning do not produce warnings.
LMD_EXPECT_SCAN_WORKERS=auto
LMD_EXPECT_CRON_PRUNE_DAYS=21
# scan_hashtype, email_addr and email_subj are informational, not enforced.
# Email recipient/subject values are not included in diagnostics.

# Optional exact cron schedule expectations (five fields, normalized whitespace).
# Signature schedule otherwise derives from LMD_EXPECT_SIGUP_INTERVAL.
# LMD_EXPECT_SIGUP_SCHEDULE="0 */6 * * *"
LMD_EXPECT_FULLSCAN_SCHEDULE="30 0 * * 0"
