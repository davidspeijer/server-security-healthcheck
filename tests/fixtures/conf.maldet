# Literal fixture based on the supplied production policy, without credentials.
email_alert="1"
email_addr="fixture@example.invalid"
email_subj="LMD report"
autoupdate_signatures="1"
sigup_interval="6"
autoupdate_version="1"
cron_prune_days="21"
import_config_url=""
scan_workers="auto"
scan_clamscan="auto"
scan_hashtype="md5"
quarantine_hits="1"
quarantine_clean="0"
quarantine_suspend_user="0"
quarantine_on_error="0"
inotify_sleep="15"
inotify_reloadtime="3600"
post_scan_hook=""
default_monitor_mode="/usr/local/maldetect/directadmin-webroots"
